# Optional API protection
SCHEMEAI_API_KEY=
# Retrieval: dense for production, lexical for offline/CI
SCHEMEAI_RETRIEVAL_MODE=dense
# Comma-separated production frontend origins. Keep * only for local development.
SCHEMEAI_ALLOWED_ORIGINS=*
# Optional OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
SCHEMEAI_API_URL=http://127.0.0.1:8000
